---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import RoundLabel from '../components/RoundLabel.astro';
import AnswerSheet from '../components/AnswerSheet.astro';
import LightString from '../components/LightString.astro';
import PackageCard from '../components/PackageCard.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, packages, startPrice } from '../data/site';
import { occasions } from '../data/occasions';
import { steps } from '../data/steps';
import { faqsFor } from '../data/faq';
import { faqSchema } from '../lib/schema';

const homeFaqs = faqsFor('home');

const facts = [
  { k: 'Gruppe', v: '8–150 Personen' },
  { k: 'Dauer', v: '2–3 Stunden' },
  { k: 'Ort', v: 'Bern und Umgebung' },
  { k: 'Preis', v: `ab ${startPrice}` },
];

const included = [
  { t: 'Massgeschneiderte Fragen', d: 'Für eure Gruppe geschrieben, nicht aus dem Internet kopiert.' },
  { t: 'Ein Quizmaster, der führt', d: 'Mit Tempo, Humor und klaren Regeln. Niemand muss Punkte auf Bierdeckeln zählen.' },
  { t: 'Bild-, Musik- und Schätzrunden', d: 'Damit auch die gewinnen können, die keine Jahreszahlen auswendig kennen.' },
  { t: 'Material und Technik', d: 'Antwortblätter, Stifte, Joker, auf Wunsch Mikrofon, Boxen und Beamer.' },
  { t: 'Auswertung und Rangliste', d: 'Nach jeder Runde, damit es spannend bleibt bis zur letzten Frage.' },
  { t: 'Ewiger Ruhm', d: 'Mindestens bis zum nächsten Quiz. Und das Recht, es allen zu erzählen.' },
];
---

<BaseLayout
  title="Pubquiz buchen in Bern – privat & für Firmen"
  description={site.description}
  jsonLd={[faqSchema(homeFaqs)]}
>
  <!-- Hero -->
  <section class="wood relative overflow-hidden">
    <LightString />
    <div class="container-page relative grid items-center gap-16 pt-24 pb-20 lg:grid-cols-[1.15fr_1fr] lg:pt-28 lg:pb-28">
      <div>
        <p class="font-hand text-2xl text-brass-2">Heute Abend: Pubquiz. Nur für euch.</p>
        <h1 class="mt-3 text-[2.6rem] leading-[1.05] sm:text-6xl lg:text-[4.2rem]">
          Euer eigenes Pubquiz in Bern. <span class="text-brass-2">Wir bringen den ganzen Abend mit.</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg sm:text-xl text-cream/75">
          Für Teamevents, Geburtstage, Polterabende oder einfach eure Freundesrunde. Wir schreiben die Fragen, auch über euch, moderieren und werten aus. Ihr müsst nur noch gewinnen.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <Button href="/anfrage/" variant="brass">Quiz unverbindlich anfragen</Button>
          <Button href="/preise/" variant="ghost-light">Preise ab {startPrice}</Button>
        </div>
        <p class="mt-5 text-sm text-cream/55">Antwort innert 24 Stunden · Anfrage kostenlos und unverbindlich</p>
      </div>
      <div class="pt-6 lg:pt-0"><AnswerSheet /></div>
    </div>
  </section>

  <!-- Fakten als Messingleiste -->
  <section aria-label="Das Wichtigste in Kürze" class="border-y-4 border-brass bg-pub text-cream">
    <dl class="container-page grid grid-cols-2 lg:grid-cols-4">
      {facts.map((f, i) => (
        <div class:list={['py-6 px-1 sm:px-4', i % 2 === 1 && 'border-l border-cream/15 pl-4', i >= 2 && 'border-t lg:border-t-0 border-cream/15', i === 2 && 'lg:border-l lg:pl-4']}>
          <dt class="text-[0.7rem] font-semibold uppercase tracking-[0.2em] text-brass">{f.k}</dt>
          <dd class="mt-1 font-display text-xl sm:text-2xl">{f.v}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- Anlässe -->
  <section class="container-page mt-24">
    <RoundLabel round="Runde 1">Für wen</RoundLabel>
    <h2 class="mt-3 text-3xl sm:text-5xl max-w-2xl">Egal was ihr feiert. Ein Quiz passt fast immer.</h2>
    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {occasions.map((o, i) => (
        <a href={`/${o.slug}/`} class="menucard group relative flex flex-col rounded-[1.25rem] p-7 transition hover:-translate-y-1 hover:border-brass">
          <span class="font-hand text-2xl text-berner">Tisch {i + 1}</span>
          <h3 class="mt-1 text-2xl">{o.card.title}</h3>
          <p class="mt-2 text-ink-soft">{o.card.text}</p>
          <span class="mt-6 inline-flex items-center gap-2 font-semibold">
            Mehr erfahren
            <span class="transition group-hover:translate-x-1" aria-hidden="true">→</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- Insider-Runde -->
  <section class="pubgreen mt-24">
    <div class="container-page grid gap-12 py-20 lg:grid-cols-2 lg:items-center">
      <div>
        <RoundLabel round="Runde 2" tone="light">Die Insider-Runde</RoundLabel>
        <h2 class="mt-3 text-3xl sm:text-5xl">Fragen, die nur ihr beantworten könnt.</h2>
        <p class="mt-5 max-w-lg text-cream/80 text-lg">
          Ihr verratet uns im Vorgespräch ein paar Anekdoten über euer Team, das Geburtstagskind oder das Brautpaar. Wir machen daraus eine Quizrunde. Erfahrungsgemäss die lauteste des Abends.
        </p>
        <a href="/faq/" class="mt-7 inline-flex font-semibold underline underline-offset-4 decoration-brass hover:text-brass-2">Wie das genau funktioniert</a>
      </div>
      <ul class="space-y-4">
        {[
          'Wie viele Kaffeekapseln verbraucht euer Büro pro Woche?',
          'Wer aus dem Team hat schon einmal in einer Band gespielt?',
          'Welches Land hat Lea auf ihrer Weltreise nach zwei Tagen wieder verlassen?',
        ].map((q, i) => (
          <li class:list={['chalkboard rounded-md p-6 sm:p-7', i === 1 && 'sm:ml-10 -rotate-1', i === 2 && 'sm:ml-4 rotate-1']}>
            <span class="font-hand text-lg text-brass-2">Insider-Frage {i + 1}</span>
            <p class="mt-1 font-hand text-[1.6rem] leading-snug">{q}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Inbegriffen -->
  <section class="container-page mt-24">
    <RoundLabel round="Runde 3">Was drin ist</RoundLabel>
    <h2 class="mt-3 text-3xl sm:text-5xl max-w-3xl">Ihr bucht einen Abend, nicht bloss einen Fragenkatalog.</h2>
    <div class="mt-12 grid gap-x-10 gap-y-9 sm:grid-cols-2 lg:grid-cols-3">
      {included.map((it, i) => (
        <div class="rule-double pt-5">
          <span class="font-hand text-2xl text-berner">{i + 1}.</span>
          <h3 class="mt-0.5 text-xl">{it.t}</h3>
          <p class="mt-2 text-ink-soft">{it.d}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Ablauf -->
  <section class="container-page mt-24">
    <div class="chalkboard rounded-xl p-8 sm:p-14">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <RoundLabel round="Runde 4" tone="light">Ablauf</RoundLabel>
          <h2 class="mt-3 text-3xl sm:text-5xl">In vier Schritten zum Quizabend.</h2>
        </div>
        <a href="/ablauf/" class="font-semibold underline underline-offset-4 decoration-brass hover:text-brass-2">Ablauf im Detail</a>
      </div>
      <ol class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {steps.map((s, i) => (
          <li>
            <span class="font-hand text-5xl text-brass-2">{i + 1}</span>
            <h3 class="mt-1 text-xl">{s.title}</h3>
            <p class="mt-1.5 text-chalk-text/70">{s.short}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Preise -->
  <section class="container-page mt-24">
    <RoundLabel round="Runde 5">Preise</RoundLabel>
    <h2 class="mt-3 text-3xl sm:text-5xl max-w-3xl">Klare Pakete, keine versteckten Kosten.</h2>
    <p class="mt-4 max-w-2xl text-lg text-ink-soft">Vorbereitung, Fragen, Moderation und Material sind immer inbegriffen. Location und Getränke organisiert ihr, gerne mit unseren Tipps.</p>
    <div class="mt-16 grid gap-12 lg:grid-cols-3 lg:gap-6">
      {packages.map((p, i) => <PackageCard pkg={p} tilt={[-8, 6, -4][i]} />)}
    </div>
    <p class="mt-8 text-ink-soft">Zusatzoptionen wie Nischenquiz oder weitere Insider-Runden findet ihr auf der <a href="/preise/" class="underline underline-offset-4 hover:text-berner">Preisseite</a>.</p>
  </section>

  <!-- Probierfrage -->
  <section class="container-page mt-24">
    <div class="chalkboard mx-auto max-w-3xl rounded-xl p-8 sm:p-14 text-center">
      <p class="font-hand text-2xl text-brass-2">Probierfrage</p>
      <p class="mt-3 font-hand text-[2rem] sm:text-[2.6rem] leading-tight">Wie viele Figurenbrunnen aus dem 16.&nbsp;Jahrhundert stehen in der Berner Altstadt?</p>
      <details class="group mt-8">
        <summary class="mx-auto inline-flex cursor-pointer list-none rounded-full border-2 border-chalk-text/50 px-6 py-3 font-semibold hover:border-brass hover:text-brass-2 [&::-webkit-details-marker]:hidden">
          <span class="group-open:hidden">Antwort aufdecken</span>
          <span class="hidden group-open:inline">Zugedeckt wäre es spannender gewesen</span>
        </summary>
        <p class="mt-6 text-lg"><strong class="font-hand text-6xl font-normal text-brass-2">11</strong><br /><span class="text-chalk-text/70">Vom Kindlifresser bis zum Gerechtigkeitsbrunnen. Wer es wusste: Wir suchen noch Leute fürs Team.</span></p>
      </details>
    </div>
  </section>

  <!-- FAQ -->
  <section class="container-page mt-24 grid gap-10 lg:grid-cols-[1fr_1.6fr]">
    <div>
      <RoundLabel round="Runde 6">Häufige Fragen</RoundLabel>
      <h2 class="mt-3 text-3xl sm:text-5xl">Gut zu wissen.</h2>
      <p class="mt-4 text-ink-soft">Mehr Antworten auf der <a href="/faq/" class="underline underline-offset-4 hover:text-berner">FAQ-Seite</a>.</p>
    </div>
    <FaqList items={homeFaqs} />
  </section>

  <CtaBand />
</BaseLayout>
