---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import LightString from '../components/LightString.astro';
---

<BaseLayout title="Danke für eure Anfrage" description="Eure Anfrage ist bei uns angekommen." noindex>
  <section class="wood relative overflow-hidden">
    <LightString />
    <div class="container-page py-28 text-center">
      <p class="font-hand text-2xl text-brass-2">Anfrage erhalten</p>
      <h1 class="mx-auto mt-3 max-w-2xl text-4xl sm:text-6xl">Richtige Antwort. <span class="text-brass-2">1 Punkt.</span></h1>
      <p class="mx-auto mt-6 max-w-xl text-lg text-cream/75">Danke für eure Anfrage. Wir melden uns innert 24 Stunden mit einer Offerte. Bis dahin: schon mal einen Teamnamen überlegen.</p>
      <div class="mt-9"><Button href="/" variant="brass">Zur Startseite</Button></div>
    </div>
  </section>
</BaseLayout>
