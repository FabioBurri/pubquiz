---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import RoundLabel from '../components/RoundLabel.astro';
import PackageCard from '../components/PackageCard.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { packages, addons, priceNotes } from '../data/site';
import { faqsFor } from '../data/faq';
import { faqSchema, breadcrumbSchema } from '../lib/schema';

const priceFaqs = faqsFor('preise');
---

<BaseLayout
  title="Preise: Pubquiz in Bern ab CHF 590"
  description="Pubquiz-Pakete in Bern: Stammtisch (8–25 Pers.) CHF 590, Feierabend (bis 60 Pers.) CHF 1’190, Grosse Runde (60–150 Pers.) ab CHF 1’890. Inkl. Fragen, Moderation, Material."
  jsonLd={[faqSchema(priceFaqs), breadcrumbSchema([{ name: 'Preise', path: '/preise/' }])]}
>
  <PageHeader
    label="Preise"
    title="Drei Pakete. Ein Fixpreis. Keine Überraschungen."
    lead="Alle Pakete enthalten Vorbereitung, massgeschneiderte Fragen, Moderation und Material. Ihr organisiert nur noch Ort und Getränke."
    crumbs={[{ name: 'Preise', path: '/preise/' }]}
  />

  <section class="container-page mt-24">
    <div class="grid gap-12 lg:grid-cols-3 lg:gap-6">
      {packages.map((p, i) => <PackageCard pkg={p} tilt={[-8, 6, -4][i]} />)}
    </div>
  </section>

  <section class="container-page mt-20 grid gap-10 lg:grid-cols-[1fr_1.6fr]">
    <div>
      <RoundLabel>Zusatzoptionen</RoundLabel>
      <h2 class="mt-3 text-3xl sm:text-4xl">Für alle, die mehr wollen</h2>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <caption class="sr-only">Zusatzoptionen und Preise</caption>
        <thead>
          <tr class="border-b-2 border-ink font-mono text-xs uppercase tracking-widest text-ink-soft">
            <th scope="col" class="py-3 pr-4 font-normal">Option</th>
            <th scope="col" class="py-3 text-right font-normal">Preis</th>
          </tr>
        </thead>
        <tbody>
          {addons.map((a) => (
            <tr class="border-b border-line align-top">
              <th scope="row" class="py-4 pr-4 font-normal">
                <span class="block font-display text-lg font-semibold">{a.name}</span>
                <span class="block text-ink-soft text-[0.95rem]">{a.note}</span>
              </th>
              <td class="py-4 text-right font-semibold whitespace-nowrap">{a.price}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <ul class="mt-6 space-y-2 text-[0.95rem] text-ink-soft">
        {priceNotes.map((n) => <li class="flex gap-2"><span class="text-berner" aria-hidden="true">•</span>{n}</li>)}
      </ul>
    </div>
  </section>

  <section class="container-page mt-20 grid gap-10 lg:grid-cols-[1fr_1.6fr]">
    <div>
      <RoundLabel>Häufige Fragen</RoundLabel>
      <h2 class="mt-3 text-3xl sm:text-4xl">Zu Preisen und Buchung</h2>
    </div>
    <FaqList items={priceFaqs} />
  </section>

  <CtaBand title="Nicht sicher, welches Paket?" text="Schreibt uns, was ihr vorhabt. Wir schlagen euch das passende Paket vor, mit Fixpreis und unverbindlich." />
</BaseLayout>
