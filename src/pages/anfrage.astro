---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { site, packages, formatCHF } from '../data/site';
import { occasions } from '../data/occasions';
import { breadcrumbSchema } from '../lib/schema';

const field = 'mt-1.5 w-full rounded-xl border-2 border-ink/20 bg-card px-4 py-3 text-base outline-none transition focus:border-brass';
const label = 'block font-semibold';
const redirect = new URL('/danke/', Astro.site).href;
---

<BaseLayout
  title="Pubquiz anfragen – unverbindlich & schnell"
  description="Fragt euer privates Pubquiz in Bern unverbindlich an: Datum, Anlass und Gruppengrösse angeben, Antwort mit Offerte innert 24 Stunden."
  jsonLd={[breadcrumbSchema([{ name: 'Anfrage', path: '/anfrage/' }])]}
>
  <PageHeader
    label="Anfrage"
    title="Euer Quizabend in zwei Minuten angefragt"
    lead="Unverbindlich und kostenlos. Ihr bekommt innert 24 Stunden eine Antwort mit Offerte und freien Daten."
    crumbs={[{ name: 'Anfrage', path: '/anfrage/' }]}
  />

  <section class="container-page mt-16 grid gap-12 lg:grid-cols-[1.6fr_1fr]">
    <form action="https://api.web3forms.com/submit" method="POST" class="grid gap-6 sm:grid-cols-2" id="anfrage">
      <input type="hidden" name="access_key" value={site.web3formsKey} />
      <input type="hidden" name="subject" value="Neue Pubquiz-Anfrage über die Website" />
      <input type="hidden" name="from_name" value={site.name} />
      <input type="hidden" name="redirect" value={redirect} />
      <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

      <div>
        <label class={label} for="anlass">Anlass</label>
        <select id="anlass" name="Anlass" class={field} required>
          <option value="">Bitte wählen</option>
          {occasions.map((o) => <option value={o.slug}>{o.card.title}</option>)}
          <option value="anderes">Etwas anderes</option>
        </select>
      </div>
      <div>
        <label class={label} for="paket">Paket <span class="font-normal text-ink-soft">(optional)</span></label>
        <select id="paket" name="Paket" class={field}>
          <option value="">Noch unklar, beratet uns</option>
          {packages.map((p) => <option value={p.id}>{p.name} · {p.people} · {p.priceFrom ? 'ab ' : ''}{formatCHF(p.price)}</option>)}
        </select>
      </div>
      <div>
        <label class={label} for="datum">Wunschdatum</label>
        <input id="datum" name="Datum" type="date" class={field} required />
      </div>
      <div>
        <label class={label} for="personen">Anzahl Personen (ca.)</label>
        <input id="personen" name="Personen" type="number" min="4" max="300" inputmode="numeric" class={field} required />
      </div>
      <div class="sm:col-span-2">
        <label class={label} for="ort">Ort <span class="font-normal text-ink-soft">(Bar, Firma, privat – oder «noch offen»)</span></label>
        <input id="ort" name="Ort" type="text" class={field} />
      </div>
      <div class="sm:col-span-2">
        <label class={label} for="wuensche">Wünsche, Themen, Insider-Ideen</label>
        <textarea id="wuensche" name="Wuensche" rows="5" class={field} placeholder="z.B. Weihnachtsessen unserer Firma, gerne eine Runde über unser Team, Niveau eher locker."></textarea>
      </div>
      <div>
        <label class={label} for="name">Name</label>
        <input id="name" name="name" type="text" autocomplete="name" class={field} required />
      </div>
      <div>
        <label class={label} for="email">E-Mail</label>
        <input id="email" name="email" type="email" autocomplete="email" class={field} required />
      </div>
      <div class="sm:col-span-2">
        <label class={label} for="telefon">Telefon <span class="font-normal text-ink-soft">(optional, falls ihr lieber telefoniert)</span></label>
        <input id="telefon" name="Telefon" type="tel" autocomplete="tel" class={field} />
      </div>
      <label class="sm:col-span-2 flex gap-3 text-[0.95rem] text-ink-soft">
        <input type="checkbox" required class="mt-1 size-5 accent-berner" />
        <span>Ich bin einverstanden, dass meine Angaben zur Bearbeitung der Anfrage verwendet werden. Mehr dazu in der <a href="/datenschutz/" class="underline underline-offset-2">Datenschutzerklärung</a>.</span>
      </label>
      <div class="sm:col-span-2">
        <button type="submit" class="inline-flex items-center justify-center rounded-full bg-berner px-8 py-4 font-semibold text-cream shadow-[0_3px_0_var(--color-ink)] transition hover:bg-berner-dark hover:translate-y-[2px] hover:shadow-[0_1px_0_var(--color-ink)]">Anfrage senden</button>
        {!site.web3formsKey && (
          <p class="mt-4 rounded-xl bg-brass/25 p-4 text-sm"><strong>Hinweis (Entwicklung):</strong> Es ist noch kein Web3Forms-Key hinterlegt (<code>src/data/site.ts</code>). Das Formular sendet erst danach.</p>
        )}
      </div>
    </form>

    <aside class="space-y-6">
      <div class="pubgreen rounded-[1.25rem] border-2 border-brass p-7 text-cream">
        <p class="font-semibold text-xs uppercase tracking-[0.18em] text-brass-2">Lieber direkt?</p>
        <p class="mt-3 font-display text-2xl">Schreibt oder ruft an.</p>
        <p class="mt-4"><a href={`mailto:${site.email}`} class="underline underline-offset-4 hover:text-brass-2">{site.email}</a></p>
        <p class="mt-1"><a href={`tel:${site.phone.replace(/\s/g, '')}`} class="underline underline-offset-4 hover:text-brass-2">{site.phoneDisplay}</a></p>
      </div>
      <div class="menucard rounded-[1.25rem] p-7">
        <p class="font-display text-xl">Was danach passiert</p>
        <ol class="mt-4 space-y-3 text-ink-soft">
          <li><strong class="text-ink">1.</strong> Wir melden uns innert 24 Stunden mit Offerte.</li>
          <li><strong class="text-ink">2.</strong> Kurzes Vorgespräch zu Gruppe und Wünschen.</li>
          <li><strong class="text-ink">3.</strong> Ihr bestätigt, wir schreiben eure Fragen.</li>
        </ol>
      </div>
    </aside>
  </section>

  <script>
    // Anlass/Paket aus Links wie /anfrage/?paket=feierabend vorauswählen
    const params = new URLSearchParams(location.search);
    for (const key of ['anlass', 'paket']) {
      const v = params.get(key);
      const el = document.getElementById(key) as HTMLSelectElement | null;
      if (v && el && [...el.options].some((o) => o.value === v)) el.value = v;
    }
    const d = document.getElementById('datum') as HTMLInputElement | null;
    if (d) d.min = new Date().toISOString().slice(0, 10);
  </script>
</BaseLayout>
