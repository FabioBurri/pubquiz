---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Button from '../components/Button.astro';
import RoundLabel from '../components/RoundLabel.astro';
import PackageCard from '../components/PackageCard.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { occasions, type Occasion } from '../data/occasions';
import { packages } from '../data/site';
import { faqsFor } from '../data/faq';
import { steps } from '../data/steps';
import { serviceSchema, faqSchema, breadcrumbSchema } from '../lib/schema';

export function getStaticPaths() {
  return occasions.map((o) => ({ params: { anlass: o.slug }, props: { o } }));
}

const { o } = Astro.props as { o: Occasion };
const pkg = packages.find((p) => p.id === o.packageId)!;
const path = `/${o.slug}/`;
let pageFaqs = faqsFor(o.faqTag);
if (pageFaqs.length < 3) pageFaqs = [...pageFaqs, ...faqsFor('home').filter((f) => !pageFaqs.includes(f))].slice(0, 4);
const others = occasions.filter((x) => x.slug !== o.slug);
---

<BaseLayout
  title={o.seoTitle}
  description={o.seoDescription}
  jsonLd={[
    serviceSchema({ name: o.h1, description: o.seoDescription, path, price: pkg.price }),
    faqSchema(pageFaqs),
    breadcrumbSchema([{ name: o.nav, path }]),
  ]}
>
  <PageHeader label={`Anlass · ${o.nav}`} title={o.h1} lead={o.lead} crumbs={[{ name: o.nav, path }]}>
    <div class="mt-9 flex flex-wrap gap-3">
      <Button href={`/anfrage/?anlass=${o.slug}`}>Jetzt anfragen</Button>
      <Button href="#preis" variant="ghost">Preis ansehen</Button>
    </div>
  </PageHeader>

  <section class="container-page mt-20 grid gap-x-12 gap-y-10 sm:grid-cols-2">
    {o.points.map((p, i) => (
      <div class="border-t-2 border-ink pt-5">
        <span class="font-mono text-sm text-berner">{String(i + 1).padStart(2, '0')}</span>
        <h2 class="mt-1 text-2xl">{p.title}</h2>
        <p class="mt-2 text-ink-soft text-lg">{p.text}</p>
      </div>
    ))}
  </section>

  <section class="container-page mt-20">
    <div class="ruled rounded-[2rem] border-2 border-ink bg-card p-7 sm:p-12">
      <RoundLabel>{o.sampleNote}</RoundLabel>
      <ol class="mt-6 space-y-5">
        {o.sampleQuestions.map((q, i) => (
          <li class="flex gap-4">
            <span class="grid size-9 shrink-0 place-items-center rounded-full border-2 border-ink font-mono font-bold">{i + 1}</span>
            <p class="pt-1 font-display text-xl sm:text-2xl font-semibold leading-snug">{q}</p>
          </li>
        ))}
      </ol>
      <p class="mt-8 text-sm text-ink-soft">Namen und Details sind erfunden. Eure Fragen schreiben wir nach dem Vorgespräch neu.</p>
    </div>
  </section>

  <section id="preis" class="container-page mt-20 grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:items-start scroll-mt-24">
    <div>
      <RoundLabel>Unsere Empfehlung</RoundLabel>
      <h2 class="mt-3 text-3xl sm:text-4xl">Das passende Paket</h2>
      <p class="mt-4 text-lg text-ink-soft">Für diesen Anlass buchen die meisten das Paket «{pkg.name}». Alle Pakete und Zusatzoptionen findet ihr auf der <a href="/preise/" class="underline underline-offset-4 hover:text-berner">Preisseite</a>.</p>
      <h3 class="mt-10 text-xl">So läuft es ab</h3>
      <ol class="mt-4 space-y-3">
        {steps.map((s, i) => (
          <li class="flex gap-3"><span class="font-mono font-bold text-berner">{i + 1}.</span><span><strong>{s.title}:</strong> <span class="text-ink-soft">{s.short}</span></span></li>
        ))}
      </ol>
    </div>
    <div class="pt-8 lg:pt-0"><PackageCard pkg={pkg} tilt={-6} /></div>
  </section>

  <section class="container-page mt-20 grid gap-10 lg:grid-cols-[1fr_1.6fr]">
    <div>
      <RoundLabel>Häufige Fragen</RoundLabel>
      <h2 class="mt-3 text-3xl sm:text-4xl">Gut zu wissen</h2>
    </div>
    <FaqList items={pageFaqs} />
  </section>

  <section class="container-page mt-20">
    <RoundLabel>Weitere Anlässe</RoundLabel>
    <div class="mt-6 grid gap-4 sm:grid-cols-3">
      {others.map((x) => (
        <a href={`/${x.slug}/`} class="rounded-2xl border-2 border-ink/10 bg-card p-5 font-display text-lg font-semibold hover:border-ink">{x.card.title} <span aria-hidden="true">→</span></a>
      ))}
    </div>
  </section>

  <CtaBand />
</BaseLayout>
