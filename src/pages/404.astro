---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import RoundLabel from '../components/RoundLabel.astro';
---

<BaseLayout title="Seite nicht gefunden" description="Diese Seite gibt es nicht." noindex>
  <section class="ruled">
    <div class="container-page py-24 text-center">
      <RoundLabel>Fehler 404</RoundLabel>
      <h1 class="mx-auto mt-4 max-w-2xl text-4xl sm:text-6xl">Leider falsch. <span class="text-berner">0 Punkte.</span></h1>
      <p class="mx-auto mt-6 max-w-xl text-lg text-ink-soft">Diese Seite gibt es nicht. Vielleicht hilft ein Joker:</p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <Button href="/">Zur Startseite</Button>
        <Button href="/anfrage/" variant="ghost">Quiz anfragen</Button>
      </div>
    </div>
  </section>
</BaseLayout>
