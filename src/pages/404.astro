---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import LightString from '../components/LightString.astro';
---

<BaseLayout title="Seite nicht gefunden" description="Diese Seite gibt es nicht." noindex>
  <section class="wood relative overflow-hidden">
    <LightString />
    <div class="container-page py-28 text-center">
      <p class="font-hand text-2xl text-brass-2">Fehler 404</p>
      <h1 class="mx-auto mt-3 max-w-2xl text-4xl sm:text-6xl">Leider falsch. <span class="text-brass-2">0 Punkte.</span></h1>
      <p class="mx-auto mt-6 max-w-xl text-lg text-cream/75">Diese Seite gibt es nicht. Vielleicht hilft ein Joker:</p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <Button href="/" variant="brass">Zur Startseite</Button>
        <Button href="/anfrage/" variant="ghost-light">Quiz anfragen</Button>
      </div>
    </div>
  </section>
</BaseLayout>
