---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import { steps } from '../data/steps';
import { breadcrumbSchema } from '../lib/schema';

const evening = [
  { time: '18:15', t: 'Wir sind da', d: 'Aufbau von Technik, Tischen und Material. Ihr kommt erst, wenn alles steht.' },
  { time: '19:00', t: 'Teams bilden', d: 'Teamnamen erfinden ist offiziell Teil des Wettbewerbs. Regeln in 3 Minuten.' },
  { time: '19:10', t: 'Runde 1 & 2', d: 'Allgemeinwissen und Bilderrunde. Nach jeder Runde gibt es den Zwischenstand.' },
  { time: '19:50', t: 'Pause', d: 'Zeit für Getränke, Essen und Verschwörungstheorien über das Leaderteam.' },
  { time: '20:10', t: 'Runde 3 & 4', d: 'Musikrunde und die Insider-Runde. Hier wird es meistens laut.' },
  { time: '20:50', t: 'Finale', d: 'Schätzfrage als Stechen, dann die Auflösung der Rangliste. Danach gehört der Abend wieder euch.' },
];
---

<BaseLayout
  title="Ablauf: So funktioniert ein gebuchtes Pubquiz"
  description={`Von der Anfrage bis zur letzten Frage: So läuft ein privates Pubquiz mit ${site.name} in Bern ab. Vier Schritte, ein Vorgespräch, ein Abend ohne Organisationsaufwand.`}
  jsonLd={[breadcrumbSchema([{ name: 'Ablauf', path: '/ablauf/' }])]}
>
  <PageHeader
    label="Ablauf"
    title="So kommt ihr zu eurem Quizabend"
    lead="Vier Schritte, davon zwei für euch. Den Rest erledigen wir."
    crumbs={[{ name: 'Ablauf', path: '/ablauf/' }]}
  />

  <section class="container-page mt-20">
    <ol class="relative ml-5 grid gap-10 border-l-[3px] border-double border-line pl-8 sm:pl-12">
      {steps.map((s, i) => (
        <li class="relative">
          <span class="absolute -left-[3.5rem] sm:-left-[4.5rem] grid size-11 place-items-center rounded-full bg-wood font-display text-lg text-brass-2 ring-8 ring-cream">{i + 1}</span>
          <h2 class="text-2xl sm:text-3xl">{s.title}</h2>
          <p class="mt-2 max-w-2xl text-lg text-ink-soft">{s.long}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="container-page mt-24">
    <div class="chalkboard rounded-xl p-8 sm:p-14">
      <p class="font-hand text-2xl text-brass-2">Beispiel · Paket «Feierabend»</p>
      <h2 class="mt-2 text-3xl sm:text-5xl">Heute an der Tafel</h2>
      <div class="mt-10">
        {evening.map((e, i) => (
          <div class:list={['grid gap-1 py-5 sm:grid-cols-[7rem_13rem_1fr] sm:items-baseline sm:gap-6', i > 0 && 'border-t border-dashed border-chalk-text/20']}>
            <span class="font-hand text-3xl text-brass-2">{e.time}</span>
            <h3 class="font-hand text-[1.7rem] leading-tight">{e.t}</h3>
            <p class="text-chalk-text/70">{e.d}</p>
          </div>
        ))}
      </div>
    </div>
    <p class="mt-4 text-sm text-ink-soft">Uhrzeiten sind ein Beispiel. Wir richten uns nach eurem Programm, auch zwischen den Gängen eines Essens.</p>
  </section>

  <CtaBand />
</BaseLayout>
