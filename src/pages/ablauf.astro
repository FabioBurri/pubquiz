---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import RoundLabel from '../components/RoundLabel.astro';
import CtaBand from '../components/CtaBand.astro';
import { steps } from '../data/steps';
import { breadcrumbSchema } from '../lib/schema';

const evening = [
  { time: '18:15', t: 'Wir sind da', d: 'Aufbau von Technik, Tischen und Material. Ihr kommt erst, wenn alles steht.' },
  { time: '19:00', t: 'Teams bilden', d: 'Teamnamen erfinden ist offiziell Teil des Wettbewerbs. Regeln in 3 Minuten.' },
  { time: '19:10', t: 'Runde 1 & 2', d: 'Allgemeinwissen und Bilderrunde. Nach jeder Runde gibt es den Zwischenstand.' },
  { time: '19:50', t: 'Pause', d: 'Zeit für Getränke, Essen und Verschwörungstheorien über das Leaderteam.' },
  { time: '20:10', t: 'Runde 3 & 4', d: 'Musikrunde und die Insider-Runde. Hier wird es meistens laut.' },
  { time: '20:50', t: 'Finale', d: 'Schätzfrage als Stechen, Siegerehrung, Fotos. Danach gehört der Abend wieder euch.' },
];
---

<BaseLayout
  title="Ablauf: So funktioniert ein gebuchtes Pubquiz"
  description="Von der Anfrage bis zur Siegerehrung: So läuft ein privates Pubquiz mit Chopfnuss in Bern ab. Vier Schritte, ein Vorgespräch, ein Abend ohne Organisationsaufwand."
  jsonLd={[breadcrumbSchema([{ name: 'Ablauf', path: '/ablauf/' }])]}
>
  <PageHeader
    label="Ablauf"
    title="So kommt ihr zu eurem Quizabend"
    lead="Vier Schritte, davon zwei für euch. Den Rest erledigen wir."
    crumbs={[{ name: 'Ablauf', path: '/ablauf/' }]}
  />

  <section class="container-page mt-20">
    <ol class="relative ml-5 grid gap-10 border-l-2 border-dashed border-line pl-8 sm:pl-12">
      {steps.map((s, i) => (
        <li class="relative">
          <span class="absolute -left-[3.45rem] sm:-left-[4.45rem] grid size-11 place-items-center rounded-full bg-berner font-display text-lg font-extrabold text-paper ring-8 ring-paper">{i + 1}</span>
          <h2 class="text-2xl sm:text-3xl">{s.title}</h2>
          <p class="mt-2 max-w-2xl text-lg text-ink-soft">{s.long}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="container-page mt-24">
    <RoundLabel>Beispiel · Paket «Feierabend»</RoundLabel>
    <h2 class="mt-3 text-3xl sm:text-5xl">Ein Quizabend, Minute für Minute</h2>
    <div class="mt-10 overflow-hidden rounded-[2rem] border-2 border-ink bg-card">
      {evening.map((e, i) => (
        <div class:list={['grid gap-2 p-6 sm:grid-cols-[7rem_14rem_1fr] sm:items-baseline sm:gap-6 sm:px-10', i > 0 && 'border-t border-line']}>
          <span class="font-mono text-lg font-bold text-berner">{e.time}</span>
          <h3 class="text-xl">{e.t}</h3>
          <p class="text-ink-soft">{e.d}</p>
        </div>
      ))}
    </div>
    <p class="mt-4 text-sm text-ink-soft">Uhrzeiten sind ein Beispiel. Wir richten uns nach eurem Programm, auch zwischen den Gängen eines Essens.</p>
  </section>

  <CtaBand />
</BaseLayout>
