---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import RoundLabel from '../components/RoundLabel.astro';
import CtaBand from '../components/CtaBand.astro';
import { breadcrumbSchema } from '../lib/schema';

// Platzhalter: echte Namen, Fotos und Texte einsetzen. Echte Gesichter verkaufen besser als jede Illustration.
const team = [
  { name: 'Vorname Nachname', role: 'Quizmaster & Fragenschreiber', fact: 'Weiss alles über Eishockey, nichts über Pflanzen.', initials: 'VN' },
  { name: 'Vorname Nachname', role: 'Quizmasterin & Organisation', fact: 'Hat noch nie eine Musikrunde verloren.', initials: 'VN' },
];
---

<BaseLayout
  title="Über uns: Die Leute hinter Chopfnuss"
  description="Chopfnuss ist ein kleines Team aus Bern, das private Pubquiz-Abende schreibt und moderiert. Lernt die Quizmaster kennen."
  jsonLd={[breadcrumbSchema([{ name: 'Über uns', path: '/ueber-uns/' }])]}
>
  <PageHeader
    label="Über uns"
    title="Wir stellen die Fragen. Seit wir denken können."
    lead="Chopfnuss ist ein kleines Team aus Bern. Wir haben jahrelang selbst an Pubquizzen mitgespielt und irgendwann angefangen, eigene zu schreiben. Heute machen wir das für andere."
    crumbs={[{ name: 'Über uns', path: '/ueber-uns/' }]}
  />

  <section class="container-page mt-20 grid gap-6 sm:grid-cols-2">
    {team.map((m, i) => (
      <article class="rounded-[2rem] border-2 border-ink/10 bg-card p-7">
        <div class:list={['grid aspect-[4/3] place-items-center rounded-2xl font-display text-6xl font-extrabold', i === 0 ? 'bg-bottle text-paper' : 'bg-senf text-ink']} aria-hidden="true">{m.initials}</div>
        <h2 class="mt-6 text-2xl">{m.name}</h2>
        <p class="text-berner font-semibold">{m.role}</p>
        <p class="mt-2 text-ink-soft">{m.fact}</p>
      </article>
    ))}
  </section>

  <section class="container-page mt-20 grid gap-10 lg:grid-cols-[1fr_1.6fr]">
    <div>
      <RoundLabel>Wofür wir stehen</RoundLabel>
      <h2 class="mt-3 text-3xl sm:text-4xl">Drei Regeln für jedes Quiz</h2>
    </div>
    <ol class="space-y-8">
      <li class="border-t-2 border-ink pt-5"><h3 class="text-xl">Niemand soll sich dumm fühlen.</h3><p class="mt-2 text-ink-soft">Gute Fragen lassen sich auch mit Logik, Bauchgefühl oder Teamwork lösen.</p></li>
      <li class="border-t-2 border-ink pt-5"><h3 class="text-xl">Jede Gruppe bekommt ihr eigenes Quiz.</h3><p class="mt-2 text-ink-soft">Wir recyceln keine Fragebögen. Was ihr spielt, wurde für euch geschrieben.</p></li>
      <li class="border-t-2 border-ink pt-5"><h3 class="text-xl">Spannend bis zur letzten Frage.</h3><p class="mt-2 text-ink-soft">Mit Zwischenständen, Jokern und einem Finale, bei dem auch Platz 3 noch gewinnen kann.</p></li>
    </ol>
  </section>

  <CtaBand />
</BaseLayout>
