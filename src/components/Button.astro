---
interface Props {
  href: string;
  variant?: 'primary' | 'ghost' | 'light';
  class?: string;
}
const { href, variant = 'primary', class: cls = '' } = Astro.props;

const styles = {
  primary: 'bg-berner text-paper hover:bg-berner-dark shadow-[0_3px_0_var(--color-ink)] hover:shadow-[0_1px_0_var(--color-ink)] hover:translate-y-[2px]',
  ghost: 'border-2 border-ink text-ink hover:bg-ink hover:text-paper',
  light: 'bg-paper text-ink hover:bg-senf shadow-[0_3px_0_var(--color-ink)] hover:shadow-[0_1px_0_var(--color-ink)] hover:translate-y-[2px]',
};
---

<a
  href={href}
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-full px-6 py-3 font-semibold transition-all duration-150 whitespace-nowrap',
    styles[variant],
    cls,
  ]}
>
  <slot />
</a>
