---
// Hero-Element: Eine Multiple-Choice-Frage als Antwortblatt, die richtige Antwort wird von Hand eingekreist.
const options = [
  { letter: 'A', text: 'Jemand aus der Runde. Um 1 Uhr nachts, mit 40 offenen Wikipedia-Tabs.' },
  { letter: 'B', text: 'Niemand. Es bleibt beim «Mir sötte mau...».' },
  { letter: 'C', text: 'Chopfnuss. Fragen, Moderation, Technik, Siegerehrung.', correct: true },
];
---

<figure class="relative mx-auto w-full max-w-md rotate-[1.5deg]">
  <div class="absolute inset-0 translate-x-2.5 translate-y-3 rounded-2xl bg-bottle" aria-hidden="true"></div>
  <div class="ruled relative rounded-2xl border-2 border-ink bg-card px-6 pt-6 pb-7 sm:px-8">
    <div class="flex items-center justify-between font-mono text-[0.7rem] uppercase tracking-[0.18em] text-ink-soft">
      <span>Runde 1 · Frage 1</span>
      <span>Team: ________</span>
    </div>
    <p class="mt-5 font-display text-2xl font-bold leading-snug">Wer organisiert euer nächstes Pubquiz?</p>
    <ol class="mt-5 space-y-3">
      {options.map((o) => (
        <li class="relative flex gap-3">
          <span class="grid size-7 shrink-0 place-items-center rounded-full border-2 border-ink font-mono text-sm font-bold">{o.letter}</span>
          <span class:list={['pt-0.5 leading-snug', o.correct ? 'font-semibold' : 'text-ink-soft']}>{o.text}</span>
          {o.correct && (
            <svg class="scribble pointer-events-none absolute -inset-x-3 -inset-y-2.5 h-[calc(100%+1.25rem)] w-[calc(100%+1.5rem)] text-berner" viewBox="0 0 300 70" preserveAspectRatio="none" aria-hidden="true">
              <path d="M18 40C14 18 80 6 160 7c80 1 132 9 131 31-1 22-70 27-150 26C60 63 8 56 12 33 15 18 46 11 70 10" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
            </svg>
          )}
        </li>
      ))}
    </ol>
    <figcaption class="mt-6 flex items-center justify-between border-t border-dashed border-line pt-4 text-sm">
      <span class="text-ink-soft">Richtige Antwort</span>
      <span class="font-mono font-bold text-berner">C · 1 Punkt</span>
    </figcaption>
  </div>
</figure>
