---
// Platzhalter-Logo: ein Bierdeckel mit Fragezeichen.
interface Props { class?: string; withText?: boolean }
const { class: cls = '', withText = true } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', cls]}>
  <svg viewBox="0 0 40 40" class="size-9 shrink-0 -rotate-6" aria-hidden="true">
    <circle cx="20" cy="20" r="19" fill="var(--color-berner)" />
    <circle cx="20" cy="20" r="15.5" fill="none" stroke="var(--color-paper)" stroke-width="1.2" stroke-dasharray="2 2.2" opacity=".7" />
    <path d="M15.2 15.6c0-3 2.2-5 5-5s5 1.9 5 4.6c0 2.2-1.3 3.2-2.7 4.1-1.2.8-1.8 1.4-1.8 2.9v.8"
      fill="none" stroke="var(--color-paper)" stroke-width="3" stroke-linecap="round" />
    <circle cx="20.7" cy="28.6" r="2" fill="var(--color-paper)" />
  </svg>
  {withText && (
    <span class="font-display text-[1.4rem] font-extrabold tracking-tight leading-none">Chopfnuss</span>
  )}
</span>
