---
// Platzhalter-Logo: rundes Pub-Schild aus Messing mit Kaufmanns-Und.
interface Props { class?: string; withText?: boolean }
const { class: cls = '', withText = true } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', cls]}>
  <svg viewBox="0 0 40 40" class="size-9 shrink-0" aria-hidden="true">
    <circle cx="20" cy="20" r="19" fill="var(--color-brass)" />
    <circle cx="20" cy="20" r="16" fill="var(--color-pub)" />
    <circle cx="20" cy="20" r="14" fill="none" stroke="var(--color-brass)" stroke-width=".8" opacity=".6" />
    <text x="20" y="27.5" text-anchor="middle" font-family="Young Serif, Georgia, serif" font-size="21" fill="var(--color-brass-2)">&amp;</text>
  </svg>
  {withText && (
    <span class="font-display text-[1.35rem] leading-none whitespace-nowrap">
      Chopf <span class="text-brass">&amp;</span> Chrage
    </span>
  )}
</span>
