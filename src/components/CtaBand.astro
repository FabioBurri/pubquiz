---
import Button from './Button.astro';
interface Props { title?: string; text?: string }
const {
  title = 'Bereit für die letzte Frage?',
  text = 'Schreibt uns Datum, Anlass und ungefähre Gruppengrösse. Ihr bekommt innert 24 Stunden eine Antwort mit Offerte, unverbindlich.',
} = Astro.props;
---

<section class="container-page mt-24">
  <div class="relative overflow-hidden rounded-[2rem] bg-berner px-6 py-14 text-paper sm:px-14">
    <svg class="pointer-events-none absolute -right-16 -bottom-24 size-80 text-paper/10" viewBox="0 0 100 100" aria-hidden="true">
      <circle cx="50" cy="50" r="48" fill="none" stroke="currentColor" stroke-width="4" stroke-dasharray="3 4"/>
      <text x="50" y="68" text-anchor="middle" font-size="58" font-weight="800" fill="currentColor" font-family="sans-serif">?</text>
    </svg>
    <p class="font-mono text-xs uppercase tracking-[0.18em] text-paper/75">Finalrunde</p>
    <h2 class="mt-3 max-w-2xl text-3xl sm:text-5xl">{title}</h2>
    <p class="mt-4 max-w-xl text-paper/85">{text}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href="/anfrage/" variant="light">Unverbindlich anfragen</Button>
      <a href="/preise/" class="inline-flex items-center rounded-full border-2 border-paper/60 px-6 py-3 font-semibold hover:bg-paper/10">Preise ansehen</a>
    </div>
  </div>
</section>
