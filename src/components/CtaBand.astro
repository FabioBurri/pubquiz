---
import Button from './Button.astro';
interface Props { title?: string; text?: string }
const {
  title = 'Bereit für die letzte Frage?',
  text = 'Schreibt uns Datum, Anlass und ungefähre Gruppengrösse. Ihr bekommt innert 24 Stunden eine Antwort mit Offerte, unverbindlich.',
} = Astro.props;
---

<section class="container-page mt-24">
  <div class="wood relative overflow-hidden rounded-[1.5rem] px-6 py-12 sm:px-14 sm:py-14">
    <p class="font-hand text-2xl text-brass-2">Finalrunde</p>
    <h2 class="mt-2 max-w-2xl text-3xl sm:text-5xl">{title}</h2>
    <p class="mt-4 max-w-xl text-cream/80">{text}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href="/anfrage/" variant="brass">Unverbindlich anfragen</Button>
      <Button href="/preise/" variant="ghost-light">Preise ansehen</Button>
    </div>
  </div>
</section>
